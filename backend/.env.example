# Copy to .env — every value below has a working default, nothing is required to run the demo.

PORT=4000
CORS_ORIGIN=http://localhost:5173

# Leave unset to run entirely on realistic simulated data (no signup needed).
# Set a free key from https://finnhub.io to switch to live quotes; the app
# automatically falls back to simulated data if the live call fails.
FINNHUB_API_KEY=

JWT_SECRET=change-this-to-a-long-random-string
DB_PATH=./data.sqlite

# How often the poller refreshes each watched symbol.
REFRESH_INTERVAL_MS=15000
# How old a cached quote can be before the UI marks it "stale".
QUOTE_TTL_MS=15000

MAX_WATCHLIST_ITEMS=200
